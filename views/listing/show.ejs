<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="row mt-3">
    <div class="col-6 offset-2">
      <h3 class="heading"><b><%= listing.title %></b></h3>
    </div>
    <div class="card col-6 offset-2 show-card">
      <img
        src="<%= listing.image %>"
        class="card-img-top show-image"
        alt="Listing-image"
      />
      <div class="card-body">
        <p class="card-text">
          <br>
          <i><%= listing.description %></i> <br />
          &#8377; <%= listing.price.toLocaleString("en-IN") %> <br />
          <%= listing.location %> <br />
          <%= listing.country %>
        </p>
      </div>
    </div>

    <div class="btns mb-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn">Edit</a>

        <form action="/listings/<%= listing._id %>?_method=delete" method="POST">
          <button class="btn btn-dark offset-2 ">Delete</button>
        </form>
    </div>

    <!-- REVIEWS -->
    <div class="col-8 offset-2 mb-3">
      <hr>
      <h4>leave a review</h4>
      <form action="/listings/<%= listing.id %>/reviews"  method="POST" class="form-label">
        <div class="mb-3 mt-3">
          <label for="rating"></label>
          <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]" >
        </div>
        <div class="mb-3 mt-3">
          <label for="comment">Comments</label>
          <textarea name="review[comment]" class="form-control" id="comment" cols="30" rows="5"></textarea>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>

  </div>
</body>
