<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3 class="heading">Listing Details</h3>
    </div>
    <div class="card col-6 offset-2 show-card">
      <img
        src="<%= listing.image %>"
        class="card-img-top show-image"
        alt="Listing-image"
      />
      <div class="card-body">
        <p class="card-text">
          <b><%= listing.title %></b><br />
          <%= listing.description %> <br />
          &#8377; <%= listing.price.toLocaleString("en-IN") %> <br />
          <%= listing.location %> <br />
          <%= listing.country %>
        </p>
      </div>
    </div>

    <div class="btns mb-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn">Edit</a>

        <form action="/listings/<%= listing._id %>?_method=delete" method="POST">
          <button class="btn btn-dark offset-2 ">Delete</button>
        </form>
    </div>
  </div>
</body>
